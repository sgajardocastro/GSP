  {
    "uri": "/leanglobal/obtenerFamilias",
    "tipo": "normal",
    "query": "select t.id_tipo_srv, t.name_tipo_srv, t.id_area, a.name_area, t.id_empresa from tsrv_tipo_template t, tpar_area a where a.id_area  = t.id_area",
