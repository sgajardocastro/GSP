fice/word/2020/wordml/sdtdatahash" xmlns:w16sdtfl="http://schemas.microsoft.com/office/word/2024/wordml/sdtformatlock" xmlns:w16se="http://schemas.microsoft.com/office/word/2015/wordml/symex" xmlns:wpg="http://schemas.microsoft.com/office/word/2010/wordprocessingGroup" xmlns:wpi="http://schemas.microsoft.com/office/word/2010/wordprocessingInk" xmlns:wne="http://schemas.microsoft.com/office/word/2006/wordml" xmlns:wps="http://schemas.microsoft.com/office/word/2010/wordprocessingShape" mc:Ignorable="w14 w15 w16se w16cid w16 w16cex w16sdtdh w16sdtfl w16du wp14"><w:body><w:p w14:paraId="65D15FE6" w14:textId="78F2CE9A" w:rsidR="00F94C29" w:rsidRPr="00447D9B" w:rsidRDefault="00000000" w:rsidP="00447D9B"><w:pPr><w:pBdr><w:bottom w:val="single" w:sz="8" w:space="4" w:color="FF6510"/></w:pBdr><w:spacing w:after="200"/><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Calibri" w:eastAsia="Calibri" w:hAnsi="Calibri" w:cs="Calibri"/><w:b/><w:bCs/><w:color w:val="1C0A91"/><w:sz w:val="32"/><w:szCs w:val="32"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Calibri" w:eastAsia="Calibri" w:hAnsi="Calibri" w:cs="Calibri"/><w:b/><w:bCs/><w:color w:val="1C0A91"/><w:sz w:val="32"/><w:szCs w:val="32"/></w:rPr><w:t>CONDICIONES Y ACUERDOS COMERCIALES: GRÚA TELESCÓPICA</w:t></w:r></w:p><w:p w14:paraId="2C58FAC2" w14:textId="77777777" w:rsidR="00F94C29" w:rsidRDefault="00000000"><w:pPr><w:spacing w:after="240"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Calibri" w:eastAsia="Calibri" w:hAnsi="Calibri" w:cs="Calibri"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Calibri" w:eastAsia="Calibri" w:hAnsi="Calibri" w:cs="Calibri"/></w:rPr><w:t>Las siguientes condiciones rigen la prestación del servicio por parte de ARRIENDOS SAN PABLO, buscando garantizar la transparencia y eficiencia operativa para nuestros clientes.</w:t></w:r></w:p><w:p w14:paraId="6C98B625" w14:textId="77777777" w:rsidR="00F94C29" w:rsidRDefault="00000000"><w:pPr><w:spacing w:after="120"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Calibri" w:eastAsia="Calibri" w:hAnsi="Calibri" w:cs="Calibri"/><w:b/><w:bCs/><w:color w:val="FF6510"/><w:sz w:val="26"/><w:szCs w:val="26"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Calibri" w:eastAsia="Calibri" w:hAnsi="Calibri" w:cs="Calibri"/><w:b/><w:bCs/><w:color w:val="FF6510"/><w:sz w:val="26"/><w:szCs w:val="26"/></w:rPr><w:t>1. Modalidad del Servicio y Disponibilidad</w:t></w:r></w:p><w:p w14:paraId="3990A932" w14:textId="77777777" w:rsidR="00F94C29" w:rsidRDefault="00000000"><w:pPr><w:numPr><w:ilvl w:val="0"/><w:numId w:val="1"/></w:numPr><w:spacing w:after="120"/><w:jc w:val="both"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Calibri" w:eastAsia="Calibri" w:hAnsi="Calibri" w:cs="Calibri"/><w:b/><w:bCs/></w:rPr><w:t xml:space="preserve">Servicio PROGRAMADO: </w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Calibri" w:eastAsia="Calibri" w:hAnsi="Calibri" w:cs="Calibri"/></w:rPr><w:t>Garantizamos al 100% la disponibilidad y concurrencia exclusiva de nuestros equipos y personal en los días y horarios acordados. Dado el compromiso de estos recursos de manera exclusiva para su operación, este servicio es facturable a todo evento, independientemente de si el equipo se utiliza o no en su totalidad durante el periodo acordado.</w:t></w:r></w:p><w:p w14:paraId="7DB7B176" w14:textId="789937FC" w:rsidR="00F94C29" w:rsidRDefault="00000000"><w:pPr><w:numPr><w:ilvl w:val="0"/><w:numId w:val="1"/></w:numPr><w:spacing w:after="240"/><w:jc w:val="both"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Calibri" w:eastAsia="Calibri" w:hAnsi="Calibri" w:cs="Calibri"/><w:b/><w:bCs/></w:rPr><w:t xml:space="preserve">Servicio A DISPOSICIÓN: </w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Calibri" w:eastAsia="Calibri" w:hAnsi="Calibri" w:cs="Calibri"/></w:rPr><w:t xml:space="preserve">La confirmación de la maquinaria queda sujeta a la disponibilidad real de nuestros equipos para el día </w:t></w:r><w:r w:rsidR="009444F7"><w:rPr><w:rFonts w:ascii="Calibri" w:eastAsia="Calibri" w:hAnsi="Calibri" w:cs="Calibri"/></w:rPr><w:t>antes del servicio</w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Calibri" w:eastAsia="Calibri" w:hAnsi="Calibri" w:cs="Calibri"/></w:rPr><w:t>. Atendemos estas solicitudes estrictamente por orden de ingreso, por lo que una pronta confirmación formal nos ayuda a gestionar su requerimiento con mayor prioridad</w:t></w:r><w:r w:rsidR="009444F7"><w:rPr><w:rFonts w:ascii="Calibri" w:eastAsia="Calibri" w:hAnsi="Calibri" w:cs="Calibri"/></w:rPr><w:t>, pero no aseguramos disponibilidad del servicio.</w:t></w:r></w:p><w:p w14:paraId="0B1FF4F4" w14:textId="77777777" w:rsidR="00F94C29" w:rsidRDefault="00000000"><w:pPr><w:spacing w:after="120"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Calibri" w:eastAsia="Calibri" w:hAnsi="Calibri" w:cs="Calibri"/><w:b/><w:bCs/><w:color w:val="FF6510"/><w:sz w:val="26"/><w:szCs w:val="26"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Calibri" w:eastAsia="Calibri" w:hAnsi="Calibri" w:cs="Calibri"/><w:b/><w:bCs/><w:color w:val="FF6510"/><w:sz w:val="26"/><w:szCs w:val="26"/></w:rPr><w:t>2. Inicio, Término de Servicio y Cobro de Horas</w:t></w:r></w:p><w:p w14:paraId="6404FC7F" w14:textId="1E02F63C" w:rsidR="00F94C29" w:rsidRDefault="00000000"><w:pPr><w:numPr><w:ilvl w:val="0"/><w:numId w:val="1"/></w:numPr><w:spacing w:after="120"/><w:jc w:val="both"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Calibri" w:eastAsia="Calibri" w:hAnsi="Calibri" w:cs="Calibri"/><w:b/><w:bCs/></w:rPr><w:t xml:space="preserve">Servicios en Radio Urbano: </w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Calibri" w:eastAsia="Calibri" w:hAnsi="Calibri" w:cs="Calibri"/></w:rPr><w:t>El tiempo de cobro (hora máquina) comenzará a regir desde que el equipo sale de nuestra base (Casa Matriz o Sucursal) hasta el término del servicio en la obra.</w:t></w:r></w:p><w:p w14:paraId="2E577565" w14:textId="77777777" w:rsidR="00F94C29" w:rsidRDefault="00000000"><w:pPr><w:numPr><w:ilvl w:val="0"/><w:numId w:val="1"/></w:numPr><w:spacing w:after="120"/><w:jc w:val="both"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Calibri" w:eastAsia="Calibri" w:hAnsi="Calibri" w:cs="Calibri"/><w:b/><w:bCs/></w:rPr><w:t xml:space="preserve">Servicios No Urbanos: </w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Calibri" w:eastAsia="Calibri" w:hAnsi="Calibri" w:cs="Calibri"/></w:rPr><w:t>El tiempo de cobro comenzará a regir desde el horario de inicio acordado directamente en la obra, hasta el término efectivo del servicio en la misma.</w:t></w:r></w:p><w:p w14:paraId="6C3F74B0" w14:textId="12E5654B" w:rsidR="00F94C29" w:rsidRDefault="00000000"><w:pPr><w:numPr><w:ilvl w:val="0"/><w:numId w:val="1"/></w:numPr><w:spacing w:after="120"/><w:jc w:val="both"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Calibri" w:eastAsia="Calibri" w:hAnsi="Calibri" w:cs="Calibri"/><w:b/><w:bCs/></w:rPr><w:t xml:space="preserve">Hora Máquina: </w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Calibri" w:eastAsia="Calibri" w:hAnsi="Calibri" w:cs="Calibri"/></w:rPr><w:t>Se entenderá por hora máquina el tiempo de reloj durante el cual el equipo esté disponible para el cliente. Se considerará 1 hora de colación como máximo dentro de la jornada</w:t></w:r><w:r w:rsidR="00447D9B"><w:rPr><w:rFonts w:ascii="Calibri" w:eastAsia="Calibri" w:hAnsi="Calibri" w:cs="Calibri"/></w:rPr><w:t>.</w:t></w:r></w:p><w:p w14:paraId="5A4BAFF6" w14:textId="37F4FD5B" w:rsidR="00447D9B" w:rsidRDefault="00000000" w:rsidP="00447D9B"><w:pPr><w:numPr><w:ilvl w:val="0"/><w:numId w:val="1"/></w:numPr><w:spacing w:after="240"/><w:jc w:val="both"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Calibri" w:eastAsia="Calibri" w:hAnsi="Calibri" w:cs="Calibri"/><w:b/><w:bCs/></w:rPr><w:t xml:space="preserve">Cobro Mínimo: </w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Calibri" w:eastAsia="Calibri" w:hAnsi="Calibri" w:cs="Calibri"/></w:rPr><w:t>Si la maquinaria trabajase menos de las horas mínimas establecidas, o si el cliente suspende el servicio una vez que el equipo ya salió de nuestras instalaciones, el cliente deberá cancelar de igual forma el mínimo de horas pactadas en esta cotización.</w:t></w:r></w:p><w:p w14:paraId="7459CEB7" w14:textId="77777777" w:rsidR="00447D9B" w:rsidRPr="00447D9B" w:rsidRDefault="00447D9B" w:rsidP="00447D9B"><w:pPr><w:numPr><w:ilvl w:val="0"/><w:numId w:val="1"/></w:numPr><w:spacing w:after="240"/><w:jc w:val="both"/></w:pPr></w:p><w:p w14:paraId="2F5EB58F" w14:textId="7011147B" w:rsidR="00F94C29" w:rsidRDefault="00000000"><w:pPr><w:spacing w:after="120"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Calibri" w:eastAsia="Calibri" w:hAnsi="Calibri" w:cs="Calibri"/><w:b/><w:bCs/><w:color w:val="FF6510"/><w:sz w:val="26"/><w:szCs w:val="26"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Calibri" w:eastAsia="Calibri" w:hAnsi="Calibri" w:cs="Calibri"/><w:b/><w:bCs/><w:color w:val="FF6510"/><w:sz w:val="26"/><w:szCs w:val="26"/></w:rPr><w:t>3. Extensiones de Servicio</w:t></w:r></w:p><w:p w14:paraId="5F67F754" w14:textId="24AA652F" w:rsidR="00F94C29" w:rsidRDefault="00000000"><w:pPr><w:numPr><w:ilvl w:val="0"/><w:numId w:val="1"/></w:numPr><w:spacing w:after="240"/><w:jc w:val="both"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Calibri" w:eastAsia="Calibri" w:hAnsi="Calibri" w:cs="Calibri"/></w:rPr><w:t xml:space="preserve">Toda extensión que exceda el tiempo o los días originalmente acordados en esta cotización será tratada operativamente como un nuevo servicio. Estará sujeta a una </w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Calibri" w:eastAsia="Calibri" w:hAnsi="Calibri" w:cs="Calibri"/></w:rPr><w:lastRenderedPageBreak/><w:t>nueva validación de disponibilidad de equipos y personal por parte de Operaciones, y requerirá una nueva cotización comercial con su respectiva aprobación.</w:t></w:r></w:p><w:p w14:paraId="32883D30" w14:textId="77777777" w:rsidR="00F94C29" w:rsidRDefault="00000000"><w:pPr><w:spacing w:after="120"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Calibri" w:eastAsia="Calibri" w:hAnsi="Calibri" w:cs="Calibri"/><w:b/><w:bCs/><w:color w:val="FF6510"/><w:sz w:val="26"/><w:szCs w:val="26"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Calibri" w:eastAsia="Calibri" w:hAnsi="Calibri" w:cs="Calibri"/><w:b/><w:bCs/><w:color w:val="FF6510"/><w:sz w:val="26"/><w:szCs w:val="26"/></w:rPr><w:t>4. Aprobación de Trabajos en Terreno (Reports)</w:t></w:r></w:p><w:p w14:paraId="2FA034F4" w14:textId="7ECB6B12" w:rsidR="00F94C29" w:rsidRDefault="00000000"><w:pPr><w:numPr><w:ilvl w:val="0"/><w:numId w:val="1"/></w:numPr><w:spacing w:after="120"/><w:jc w:val="both"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Calibri" w:eastAsia="Calibri" w:hAnsi="Calibri" w:cs="Calibri"/></w:rPr><w:t>El cliente se compromete a firmar diariamente el Report de Servicio (</w:t></w:r><w:r w:rsidR="00447D9B"><w:rPr><w:rFonts w:ascii="Calibri" w:eastAsia="Calibri" w:hAnsi="Calibri" w:cs="Calibri"/></w:rPr><w:t>en papel físico o digital</w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Calibri" w:eastAsia="Calibri" w:hAnsi="Calibri" w:cs="Calibri"/></w:rPr><w:t>) realizado por nuestro operador.</w:t></w:r></w:p><w:p w14:paraId="301C384D" w14:textId="77777777" w:rsidR="00F94C29" w:rsidRDefault="00000000"><w:pPr><w:numPr><w:ilvl w:val="0"/><w:numId w:val="1"/></w:numPr><w:spacing w:after="240"/><w:jc w:val="both"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Calibri" w:eastAsia="Calibri" w:hAnsi="Calibri" w:cs="Calibri"/></w:rPr><w:t xml:space="preserve">En caso de que nuestro personal no pueda obtener la firma del responsable en obra, el operador informará inmediatamente a Operaciones de San Pablo. Ante esta situación, el report se dará por </w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Calibri" w:eastAsia="Calibri" w:hAnsi="Calibri" w:cs="Calibri"/><w:b/><w:bCs/></w:rPr><w:t>aprobado por defecto</w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Calibri" w:eastAsia="Calibri" w:hAnsi="Calibri" w:cs="Calibri"/></w:rPr><w:t xml:space="preserve"> y el ejecutivo comercial enviará el respaldo correspondiente al cliente para formalizar el cierre del día.</w:t></w:r></w:p><w:p w14:paraId="45A8BCA3" w14:textId="77777777" w:rsidR="00F94C29" w:rsidRDefault="00000000"><w:pPr><w:spacing w:after="120"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Calibri" w:eastAsia="Calibri" w:hAnsi="Calibri" w:cs="Calibri"/><w:b/><w:bCs/><w:color w:val="FF6510"/><w:sz w:val="26"/><w:szCs w:val="26"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Calibri" w:eastAsia="Calibri" w:hAnsi="Calibri" w:cs="Calibri"/><w:b/><w:bCs/><w:color w:val="FF6510"/><w:sz w:val="26"/><w:szCs w:val="26"/></w:rPr><w:t>5. Responsabilidades Operativas y Fuerza Mayor</w:t></w:r></w:p><w:p w14:paraId="75598ACF" w14:textId="77777777" w:rsidR="00F94C29" w:rsidRDefault="00000000"><w:pPr><w:numPr><w:ilvl w:val="0"/><w:numId w:val="1"/></w:numPr><w:spacing w:after="120"/><w:jc w:val="both"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Calibri" w:eastAsia="Calibri" w:hAnsi="Calibri" w:cs="Calibri"/><w:b/><w:bCs/></w:rPr><w:t xml:space="preserve">Condiciones del Terreno: </w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Calibri" w:eastAsia="Calibri" w:hAnsi="Calibri" w:cs="Calibri"/></w:rPr><w:t>Será responsabilidad exclusiva del cliente informar sobre la resistencia y condiciones del terreno y/o área de trabajo. En caso contrario, ARRIENDOS SAN PABLO se desliga de cualquier responsabilidad por daños que la máquina pueda ocasionar (hundimientos, roturas de lozas, etc.).</w:t></w:r></w:p><w:p w14:paraId="072F1FFD" w14:textId="77777777" w:rsidR="00F94C29" w:rsidRDefault="00000000"><w:pPr><w:numPr><w:ilvl w:val="0"/><w:numId w:val="1"/></w:numPr><w:spacing w:after="120"/><w:jc w:val="both"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Calibri" w:eastAsia="Calibri" w:hAnsi="Calibri" w:cs="Calibri"/><w:b/><w:bCs/></w:rPr><w:t xml:space="preserve">Contrapesos: </w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Calibri" w:eastAsia="Calibri" w:hAnsi="Calibri" w:cs="Calibri"/></w:rPr><w:t>Será por cuenta del cliente el traslado de contrapesos durante y dentro del recinto de faena, si la maniobra lo requiere.</w:t></w:r></w:p><w:p w14:paraId="35EAD8E5" w14:textId="787D45FC" w:rsidR="00F94C29" w:rsidRDefault="00000000"><w:pPr><w:numPr><w:ilvl w:val="0"/><w:numId w:val="1"/></w:numPr><w:spacing w:after="120"/><w:jc w:val="both"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Calibri" w:eastAsia="Calibri" w:hAnsi="Calibri" w:cs="Calibri"/><w:b/><w:bCs/></w:rPr><w:t xml:space="preserve">Uso Adecuado: </w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Calibri" w:eastAsia="Calibri" w:hAnsi="Calibri" w:cs="Calibri"/></w:rPr><w:t>Las máquinas se ocuparán en faenas estrictamente de acuerdo a sus condiciones y capacidad técnica para lo cual han sido diseñadas</w:t></w:r><w:r w:rsidR="00447D9B"><w:rPr><w:rFonts w:ascii="Calibri" w:eastAsia="Calibri" w:hAnsi="Calibri" w:cs="Calibri"/></w:rPr><w:t xml:space="preserve"> y contratadas.</w:t></w:r></w:p><w:p w14:paraId="0D8F9493" w14:textId="77777777" w:rsidR="00F94C29" w:rsidRDefault="00000000"><w:pPr><w:numPr><w:ilvl w:val="0"/><w:numId w:val="1"/></w:numPr><w:spacing w:after="240"/><w:jc w:val="both"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Calibri" w:eastAsia="Calibri" w:hAnsi="Calibri" w:cs="Calibri"/><w:b/><w:bCs/></w:rPr><w:t xml:space="preserve">Fuerza Mayor: </w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Calibri" w:eastAsia="Calibri" w:hAnsi="Calibri" w:cs="Calibri"/></w:rPr><w:t>Si por eventos inesperados o de fuerza mayor (maquinarias encerradas en faenas, fallas mecánicas fortuitas, alta congestión de tránsito, etc.) la grúa se ve impedida de llegar el día y hora programada, no corresponderá ningún tipo de descuento ni cobro a ARRIENDOS SAN PABLO. Tampoco procederá el endoso de multas o infracciones de cualquier tipo.</w:t></w:r></w:p><w:p w14:paraId="58437489" w14:textId="77777777" w:rsidR="00F94C29" w:rsidRDefault="00000000"><w:pPr><w:spacing w:after="120"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Calibri" w:eastAsia="Calibri" w:hAnsi="Calibri" w:cs="Calibri"/><w:b/><w:bCs/><w:color w:val="FF6510"/><w:sz w:val="26"/><w:szCs w:val="26"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Calibri" w:eastAsia="Calibri" w:hAnsi="Calibri" w:cs="Calibri"/><w:b/><w:bCs/><w:color w:val="FF6510"/><w:sz w:val="26"/><w:szCs w:val="26"/></w:rPr><w:t>6. Condiciones Administrativas</w:t></w:r></w:p><w:p w14:paraId="2EDAA142" w14:textId="77777777" w:rsidR="00F94C29" w:rsidRDefault="00000000"><w:pPr><w:numPr><w:ilvl w:val="0"/><w:numId w:val="1"/></w:numPr><w:spacing w:after="120"/><w:jc w:val="both"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Calibri" w:eastAsia="Calibri" w:hAnsi="Calibri" w:cs="Calibri"/><w:b/><w:bCs/></w:rPr><w:t xml:space="preserve">Validez: </w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Calibri" w:eastAsia="Calibri" w:hAnsi="Calibri" w:cs="Calibri"/></w:rPr><w:t>La presente cotización tiene una validez de 05 días hábiles.</w:t></w:r></w:p><w:p w14:paraId="146933A0" w14:textId="77777777" w:rsidR="00F94C29" w:rsidRDefault="00000000"><w:pPr><w:numPr><w:ilvl w:val="0"/><w:numId w:val="1"/></w:numPr><w:spacing w:after="120"/><w:jc w:val="both"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Calibri" w:eastAsia="Calibri" w:hAnsi="Calibri" w:cs="Calibri"/><w:b/><w:bCs/></w:rPr><w:t xml:space="preserve">Condiciones de Pago: </w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Calibri" w:eastAsia="Calibri" w:hAnsi="Calibri" w:cs="Calibri"/></w:rPr><w:t>La factura deberá ser cancelada a los 30 días de su fecha de emisión, siempre y cuando el cliente cuente con un crédito aprobado a 30 días por nuestro departamento de finanzas.</w:t></w:r></w:p><w:p w14:paraId="22EE4204" w14:textId="77777777" w:rsidR="00F94C29" w:rsidRDefault="00000000"><w:pPr><w:numPr><w:ilvl w:val="0"/><w:numId w:val="1"/></w:numPr><w:spacing w:after="240"/><w:jc w:val="both"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Calibri" w:eastAsia="Calibri" w:hAnsi="Calibri" w:cs="Calibri"/><w:b/><w:bCs/></w:rPr><w:t xml:space="preserve">Valores: </w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Calibri" w:eastAsia="Calibri" w:hAnsi="Calibri" w:cs="Calibri"/></w:rPr><w:t xml:space="preserve">Todos los valores expresados en este documento son </w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Calibri" w:eastAsia="Calibri" w:hAnsi="Calibri" w:cs="Calibri"/><w:b/><w:bCs/></w:rPr><w:t>más IVA</w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Calibri" w:eastAsia="Calibri" w:hAnsi="Calibri" w:cs="Calibri"/></w:rPr><w:t>.</w:t></w:r></w:p><w:sectPr w:rsidR="00F94C29"><w:pgSz w:w="12240" w:h="15840"/><w:pgMar w:top="1440" w:right="1440" w:bottom="1440" w:left="1440" w:header="720" w:footer="720" w:gutter="0"/><w:cols w:space="720"/></w:sectPr></w:body></w:document>
