generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model audit_results {
  id               Int       @id(map: "audit_results_pkey1") @default(autoincrement())
  audit_id         Int?
  phase_id         String?   @db.VarChar(50)
  item_internal_id String    @db.VarChar(50)
  category_name    String?   @db.VarChar(200)
  question_text    String?
  score            Decimal?  @db.Decimal(5, 2)
  is_na            Boolean?  @default(false)
  observation      String?
  evidence_urls    String[]
  created_at       DateTime? @default(now()) @db.Timestamptz(6)
  audits           audits?   @relation(fields: [audit_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "audit_results_audit_id_fkey1")

  @@index([audit_id], map: "idx_dev_audit_results_audit_id")
}

model auditory_types {
  id          Int       @id(map: "auditory_types_pkey1") @default(autoincrement())
  name        String    @unique(map: "auditory_types_name_key1") @db.VarChar(50)
  description String?
  created_at  DateTime? @default(now()) @db.Timestamptz(6)
  audits      audits[]
}

model audits {
  id              Int             @id(map: "audits_pkey1") @default(autoincrement())
  type_id         Int?
  version         String?         @db.VarChar(20)
  division        String?         @db.VarChar(100)
  company_name    String?         @db.VarChar(200)
  service_name    String?
  contract_number String?         @db.VarChar(100)
  admin_eecc      String?         @db.VarChar(200)
  apr_eecc        String?         @db.VarChar(200)
  audit_date      DateTime        @db.Date
  status          String?         @default("Borrador") @db.VarChar(50)
  total_score     Decimal?        @db.Decimal(5, 2)
  created_by      String?         @db.VarChar(100)
  created_at      DateTime?       @default(now()) @db.Timestamptz(6)
  updated_at      DateTime?       @default(now()) @db.Timestamptz(6)
  audit_results   audit_results[]
  auditory_types  auditory_types? @relation(fields: [type_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "audits_type_id_fkey1")
}

model tcla_campanas {
  id_campana               Int                        @id @default(autoincrement())
  id_empresa               Int
  nombre                   String                     @db.VarChar(255)
  descripcion              String?
  fecha_inicio             DateTime                   @db.Date
  fecha_termino            DateTime                   @db.Date
  estado                   String?                    @default("ABIERTA") @db.VarChar(20)
  fecha_creacion           DateTime?                  @default(now()) @db.Timestamp(6)
  tcla_encuesta_control    tcla_encuesta_control[]
  tcla_encuesta_respuestas tcla_encuesta_respuestas[]
}

model tcla_encuesta_control {
  token_uuid          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  id_campana          Int
  id_colaborador      Int
  nombre_participante String?       @db.VarChar(255)
  correo_participante String?       @db.VarChar(255)
  cargo               String?       @db.VarChar(100)
  departamento        String?       @db.VarChar(100)
  sucursal            String?       @db.VarChar(100)
  id_departamento     Int?
  id_sucursal         Int?
  completado          Boolean?      @default(false)
  fecha_generacion    DateTime?     @default(now()) @db.Timestamp(6)
  fecha_completado    DateTime?     @db.Timestamp(6)
  tcla_campanas       tcla_campanas @relation(fields: [id_campana], references: [id_campana], onDelete: NoAction, onUpdate: NoAction)
}

model tcla_encuesta_respuestas {
  id                 Int           @id @default(autoincrement())
  id_campana         Int
  id_empresa         Int
  departamento       String?       @db.VarChar(100)
  sucursal           String?       @db.VarChar(100)
  id_departamento    Int?
  id_sucursal        Int?
  respuestas_json    Json
  comentario_abierto String?
  fecha_registro     DateTime?     @default(dbgenerated("CURRENT_DATE")) @db.Date
  tcla_campanas      tcla_campanas @relation(fields: [id_campana], references: [id_campana], onDelete: NoAction, onUpdate: NoAction)
}

